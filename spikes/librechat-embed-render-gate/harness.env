# Environment for the NOA side of the embed render gate run (T59).
#
# Development values only, and no key material: `ENVIRONMENT=development` makes NOA generate
# its Fernet key and JWT secret at boot (V52, V53), so nothing secret is committed here (C11).
#
# Two settings carry the experiment rather than convenience:
#   AUTH_SESSION_COOKIE_DOMAIN  — registrable-domain scope is what lets the cookie reach the
#                                 embed origin from a chat.noa.internal parent (V40).
#   AUTH_DEV_BYPASS_LDAP        — no directory in this rig; the operator row is provisioned
#                                 and activated by the bootstrap path (V7).
#
# `AUTH_SESSION_COOKIE_SECURE` is deliberately absent: development forces it off, because a
# Secure cookie is never sent over the plain HTTP this rig speaks.

ENVIRONMENT=development
POSTGRES_URL=postgresql+asyncpg://noa:noa@localhost:5432/noa

AUTH_SESSION_COOKIE_NAME=noa_session
AUTH_SESSION_COOKIE_DOMAIN=.noa.internal
AUTH_SESSION_COOKIE_PATH=/
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_BOOTSTRAP_ADMIN_EMAILS='["operator@noa.internal"]'
AUTH_DEV_BYPASS_LDAP=true

LDAP_SERVER_URI=ldap://ldap.invalid:389
LDAP_ALLOW_INSECURE_TRANSPORT=true
LDAP_BIND_DN=svc-noa@noa.internal
LDAP_BIND_PASSWORD=unused-under-dev-bypass
LDAP_BASE_DN=dc=noa,dc=internal
LDAP_USER_FILTER="(|(mail={email})(userPrincipalName={email}))"

NOA_EMBED_BASE_URL=http://embed.noa.internal:8000
NOA_LIBRECHAT_ORIGIN=http://chat.noa.internal:3080
API_CORS_ALLOWED_ORIGINS='["http://chat.noa.internal:3080"]'
