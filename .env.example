# --- NOA shared local development env (repo root) ---
# Copy to ./.env  (gitignored per C11).
# Production (K8s): provide via ConfigMaps/Secrets, ⊥ this file.
# Env vars for lists use JSON arrays (C11).

# Runtime
ENVIRONMENT=development

# --- Database (C3) ---
POSTGRES_URL=postgresql+asyncpg://noa:noa@localhost:5432/noa
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Secret encryption (C7, V52) ---
# Encrypts server credentials (SSH creds, API tokens), NOT the database.
# Required in production. Auto-generated in dev when absent.
NOA_SECRET_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- Auth / JWT (V6, V53) ---
# Required in production, >=32 chars. Auto-generated in dev.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_SESSION_COOKIE_NAME=noa_session
# Registrable-domain scope so the cookie rides to the embed origin too (V40).
AUTH_SESSION_COOKIE_DOMAIN=.noa.internal
AUTH_SESSION_COOKIE_PATH=/
# V6 wants Lax. Allowed: lax | strict | none.
AUTH_SESSION_COOKIE_SAMESITE=lax
# Forced off in development/test (plain HTTP would never send a Secure cookie).
AUTH_SESSION_COOKIE_SECURE=true
AUTH_BOOTSTRAP_ADMIN_EMAILS=["admin@example.com"]
# AUTH_DEV_BYPASS_LDAP=true

# Login rate limiting (V9)
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=600

# --- LDAP (C4, V7) ---
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_ALLOW_INSECURE_TRANSPORT=true
LDAP_BIND_DN=svc-noa@example.com
LDAP_BIND_PASSWORD=replace-with-ldap-password
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_FILTER=(|(mail={email})(userPrincipalName={email}))
LDAP_TIMEOUT_SECONDS=5

# --- MCP tokens (C5, V4) ---
# LDAP revalidation staleness interval; LDAP down -> fail closed.
MCP_TOKEN_LDAP_REVALIDATE_SECONDS=900
# MCP_TOKEN_TTL_SECONDS=  # empty -> non-expiring until revoked

# --- Approval gate (V31, V32) ---
# Per-user in-flight CHANGE executions; over limit -> 409 (V31).
APPROVAL_MAX_INFLIGHT_PER_USER=1
# Pending request TTL -> EXPIRED (V32).
APPROVAL_PENDING_TTL_SECONDS=3600

# --- Origins / CORS ---
API_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
API_CORS_ALLOW_CREDENTIALS=true
# Embed app origin, used to build approval URLs (V26: id only, no token).
NOA_EMBED_BASE_URL=http://localhost:3001
# LibreChat origin allowed to frame the embed app (V41).
NOA_LIBRECHAT_ORIGIN=https://chat.noa.internal

# --- yopass (C15, V50) ---
# Absent -> password-reset tool returns `yopass_not_configured`; app still starts.
# YOPASS_BASE_URL=https://yopass.example.com
# YOPASS_SECRET_EXPIRATION_SECONDS=604800
# YOPASS_ONE_TIME=false
# SECRET_PASSWORD_LENGTH=24

# --- Web -> API proxy target (server-side only) ---
NOA_API_URL=http://localhost:8000
