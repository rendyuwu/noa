# --- NOA shared local development env (repo root) ---
# Copy to ./.env  (gitignored per C11).
# Production (K8s): provide via ConfigMaps/Secrets, ⊥ this file.
# Env vars for lists use JSON arrays (C11).

# Runtime
ENVIRONMENT=development

# --- Database (C3) ---
POSTGRES_URL=postgresql+asyncpg://noa:noa@localhost:5432/noa
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Secret encryption (C7, V52) ---
# Encrypts server credentials (SSH creds, API tokens), NOT the database.
# Required in production. Auto-generated in dev when absent.
NOA_SECRET_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- Auth / JWT (V6, V53) ---
# Session cookie credential for admin-web + web-embed. MCP bearer tokens are a
# separate mechanism (C5) and are not configured here.
# Required in production, >=32 chars. Auto-generated in dev.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# HMAC only: HS256 | HS384 | HS512. Anything else fails when the JWT service is built.
# Secret must meet the RFC 7518 minimum for the algorithm chosen:
# HS256 >=32 bytes, HS384 >=48, HS512 >=64.
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_SESSION_COOKIE_NAME=noa_session
# Registrable-domain scope so the cookie rides to the embed origin too (V40).
AUTH_SESSION_COOKIE_DOMAIN=.noa.internal
AUTH_SESSION_COOKIE_PATH=/
# V6 wants Lax. Allowed: lax | strict | none.
# `none` requires a Secure cookie (browsers discard SameSite=None without it), so it
# is rejected at startup in development/test, where Secure is forced off.
AUTH_SESSION_COOKIE_SAMESITE=lax
# Forced off in development/test (plain HTTP would never send a Secure cookie).
AUTH_SESSION_COOKIE_SECURE=true
AUTH_BOOTSTRAP_ADMIN_EMAILS=["admin@example.com"]
# AUTH_DEV_BYPASS_LDAP=true

# Login rate limiting (V9)
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=600

# --- LDAP (C4, V7) ---
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_ALLOW_INSECURE_TRANSPORT=true
LDAP_BIND_DN=svc-noa@example.com
LDAP_BIND_PASSWORD=replace-with-ldap-password
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_FILTER=(|(mail={email})(userPrincipalName={email}))
LDAP_TIMEOUT_SECONDS=5

# --- MCP tokens (C5, V4) ---
# LDAP revalidation staleness interval; LDAP down -> fail closed.
MCP_TOKEN_LDAP_REVALIDATE_SECONDS=900
# MCP_TOKEN_TTL_SECONDS=  # empty -> non-expiring until revoked

# Failed-MCP-auth rate limiting (V9). Buckets are keyed per LibreChat account and per
# presented token, never per source address — in-cluster it identifies nothing, and
# LibreChat is the only client (C24), so an address block would take out every operator.
MCP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MCP_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
MCP_AUTH_RATE_LIMIT_BLOCK_SECONDS=600

# --- Approval gate (V30, V31, V32) ---
# Per-user in-flight CHANGE executions; over limit -> 409 (V31).
APPROVAL_MAX_INFLIGHT_PER_USER=1
# Pending request TTL -> EXPIRED (V32).
APPROVAL_PENDING_TTL_SECONDS=3600
# How often the background sweep expires pending requests past their deadline (V32, T39).
APPROVAL_EXPIRY_SWEEP_INTERVAL_SECONDS=60
# How long a tool run may sit STARTED before the reaper records it abandoned (V30, T38).
# A lifetime, not a resolution: raise it only if a legitimate change can take longer.
APPROVAL_STRANDED_RUN_REAP_AFTER_SECONDS=900
# How often the reaper looks for those runs (V30, T38).
APPROVAL_STRANDED_RUN_REAP_INTERVAL_SECONDS=120
# How many stranded runs one pass may resolve (V92, T38). Drain rate = this over the interval
# above: 100 per 120s. A truncated pass logs how many it left, so a capped pass never reads
# like a complete one.
APPROVAL_STRANDED_RUN_REAP_BATCH_SIZE=100

# --- Large READ results (V64, V85, T56) ---
# How long a parked table stays readable behind its URL. A lifetime: the address rides in a
# tool result that persists in LibreChat's transcript, so an operator may open it hours later.
# Past it, the surface answers as it does for an unknown token.
RESULT_TABLE_TTL_SECONDS=86400
# How many rows one parked table may hold. The row records the pre-cut total and a truncation
# flag beside the rows, and the page renders both -- a capped table never reads like a whole one.
RESULT_TABLE_MAX_ROWS=5000

# --- Origins / CORS ---
API_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
API_CORS_ALLOW_CREDENTIALS=true
# Embed app origin, used to build approval URLs (V26: id only, no token).
NOA_EMBED_BASE_URL=http://localhost:3001
# Where an operator signs in when the approval card answers 401 (V38, V42, T43). The whole URL,
# because the embed has no login page of its own and the admin app owns that route (T50) -- a
# deployment that moves it sets this rather than needing a code change. Read at REQUEST time by
# `apps/web-embed` (server-side, no `NEXT_PUBLIC_*` twin), so unlike the framing origin below it is
# not baked at build. Absent, blank or anything that is not an http/https URL -> the 401 card names
# the state and offers no link: a door to a host nobody deployed reads as an action that was
# refused. The API does not read this var.
NOA_SIGN_IN_URL=http://localhost:3000/login
# LibreChat origin allowed to frame the embed app (V41). Read by `apps/web-embed` at BUILD time
# (`next.config.ts` -> `config/framing.ts`) into `Content-Security-Policy: frame-ancestors`, so a
# runtime value cannot widen the allowlist -- and cannot change it either: moving LibreChat means
# rebuilding the embed. One origin only; a wildcard, a path or a second origin fails the build.
NOA_LIBRECHAT_ORIGIN=https://chat.noa.internal

# --- yopass (C15, V50) ---
# Absent -> password-reset tool returns `yopass_not_configured`; app still starts.
# YOPASS_BASE_URL=https://yopass.example.com
# YOPASS_SECRET_EXPIRATION_SECONDS=604800
# YOPASS_ONE_TIME=false
# SECRET_PASSWORD_LENGTH=24

# --- Web -> API proxy target (server-side only) ---
NOA_API_URL=http://localhost:8000
